{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter strapi build"
  },
  "deploy": {
    "startCommand": "pnpm --filter strapi start",
    "healthcheckPath": "/_health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
